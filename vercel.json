{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "topup_tournament.sqlite",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/|assets/|css/|js/|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
